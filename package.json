{
  "name": "my-tweakcn-theme",
  "version": "1.0.0",
  "description": "11 shadcn/Tailwind-v4 themes ported 1:1 from tweakcn presets and community themes (Cloudflare, Neo Brutalism, Sage Garden, T3 Chat, Discord, ...) with React theme provider, light/dark toggle and variant switcher.",
  "type": "module",
  "main": "src/index.ts",
  "files": [
    "src",
    "themes",
    "vanilla",
    "base.css",
    "docs",
    "README.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "shadcn",
    "shadcn-ui",
    "tailwind",
    "tailwindcss",
    "theme",
    "themes",
    "tweakcn",
    "dark-mode",
    "theme-switcher",
    "design-tokens",
    "css-variables"
  ],
  "peerDependencies": {
    "@radix-ui/react-dropdown-menu": ">=2",
    "clsx": ">=2",
    "lucide-react": ">=0.400",
    "react": ">=18",
    "react-dom": ">=18",
    "tailwind-merge": ">=2",
    "tailwindcss": ">=4"
  },
  "devDependencies": {
    "@radix-ui/react-dropdown-menu": "^2.1.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "clsx": "^2.1.0",
    "lucide-react": "^0.400.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "tailwind-merge": "^2.5.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.5.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jhonoryza/my-tweakcn-theme.git"
  },
  "author": "jhonoryza"
}
